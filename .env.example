# Copy this file to .env and fill in ONE option. Never commit .env.

# Option A: Vertex AI in your own Google Cloud project.
# Sign in first: gcloud auth application-default login
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=<your-project-id>
GOOGLE_CLOUD_LOCATION=global

# Option B: a Gemini API key. Comment out Option A and uncomment these two.
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=<your-key>

# The model every agent uses. Pick one your project or key can call.
MODEL=gemini-3.8-flash
